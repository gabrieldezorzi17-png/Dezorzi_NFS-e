# Modelo do .env. Copie para `.env` e preencha.
#
# O `.env` de verdade não vai para o repositório (ver .gitignore); este
# arquivo existe para a compilação na nuvem ter de onde partir, e para
# quem clonar o projeto saber quais chaves existem.

# Digitada na tela de entrada; nunca gravada.
NFSE_SENHA=

# Deixe vazias: o programa lê do portal no primeiro login e grava aqui.
NFSE_GWT_PERMUTATION=
NFSE_GWT_POLICY=

# true = envia de verdade à prefeitura.
NFSE_LIVE_MODE=true
NFSE_TEMA=escuro

# Endereço do version.json publicado. PRECISA estar preenchido aqui para
# a compilação na nuvem gerar uma cópia que procura atualização.
NFSE_ATUALIZACAO_URL=https://api.github.com/repos/gabrieldezorzi17-png/Dezorzi_NFS-e/releases/latest
